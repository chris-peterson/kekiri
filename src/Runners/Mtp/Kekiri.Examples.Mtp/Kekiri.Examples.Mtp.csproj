<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kekiri.Examples.Mtp</RootNamespace>
    <!-- Both of these packages generate an entry point, and Program.cs writes its own Main. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Rider shows nothing for this project without Microsoft.NET.Test.Sdk, the only thing here that
      sets IsTestProject=true. The Testing Platform capabilities Rider talks over
      (TestingPlatformServer, TestContainer) already arrive through the ProjectReference to
      Kekiri.Mtp, so those were not what was missing; JetBrains names this same package as the
      workaround in RIDER-129745. Neither package brings a test framework or a VSTest adapter.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Kekiri\Kekiri.csproj" />
    <ProjectReference Include="..\Kekiri.Mtp\Kekiri.Mtp.csproj" />
  </ItemGroup>

</Project>
