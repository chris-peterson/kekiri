<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <DebugType>portable</DebugType>
    <AssemblyName>Kekiri.Xunit</AssemblyName>
    <RootNamespace>Kekiri.Xunit</RootNamespace>
    <PackageId>Kekiri.Xunit</PackageId>
    <Copyright>2012-2026</Copyright>
    <PackageTags>bdd;scenario;test;gherkin;cucumber;pickles;xunit;specflow</PackageTags>
    <PackageReleaseNotes>
Changes:

- Migrate to xUnit.net v3
- Add assembly-level IoC bootstrapping via [assembly: KekiriBootstrap] (no more per-class [Collection] attributes)
- Target net8.0 (was netstandard2.0)
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/chris-peterson/kekiri#overview</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chris-peterson/kekiri</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>3.0.0</Version>
    <Authors>Chris Peterson</Authors>
    <Description>xUnit.net v3 test runner for Kekiri</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IsPackable>True</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Kekiri\Kekiri.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.0" />
  </ItemGroup>
</Project>
