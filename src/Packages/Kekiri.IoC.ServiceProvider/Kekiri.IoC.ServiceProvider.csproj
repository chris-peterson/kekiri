<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection integration for Kekiri.</Description>
    <Copyright>2019-2026</Copyright>
    <Authors>smarts, Chris Peterson</Authors>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Kekiri.IoC.ServiceProvider</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>Kekiri.IoC.ServiceProvider</PackageId>
    <PackageTags>$(PackageTags);dependency-injection</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kekiri\Kekiri.csproj" />
  </ItemGroup>

</Project>
