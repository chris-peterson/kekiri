<Project>

  <!--
    Shared package metadata. Versions stay per-project so the packages can move
    independently.
  -->
  <PropertyGroup>
    <Authors>Chris Peterson</Authors>
    <Copyright>2012-2026</Copyright>
    <PackageProjectUrl>https://github.com/chris-peterson/kekiri</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chris-peterson/kekiri</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>bdd;scenario;test;gherkin;cucumber;pickles;specflow</PackageTags>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
