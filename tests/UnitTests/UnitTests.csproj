<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Kekiri.UnitTests</AssemblyName>
    <RootNamespace>Kekiri.Tests</RootNamespace>
    <!-- The tests drive the runner through the platform's evaluation-only request types. -->
    <NoWarn>$(NoWarn);TPEXP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TUnit's engine and assertions rather than the TUnit meta-package, which also brings Microsoft's
      code coverage extension; coverage comes from coverlet (MIT) instead.
    -->
    <PackageReference Include="TUnit.Engine" Version="1.65.51" />
    <PackageReference Include="TUnit.Assertions" Version="1.65.51" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <!-- DocSnippetTests compiles the C# in the docs; the examples assert with AwesomeAssertions. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Packages\Kekiri\Kekiri.csproj" />
    <ProjectReference Include="..\..\src\Packages\Kekiri.Mtp\Kekiri.Mtp.csproj" />
    <ProjectReference Include="..\..\src\Packages\Kekiri.IoC.Autofac\Kekiri.IoC.Autofac.csproj" />
    <ProjectReference Include="..\..\src\Packages\Kekiri.IoC.ServiceProvider\Kekiri.IoC.ServiceProvider.csproj" />
    <ProjectReference Include="..\WebApp\WebApp.csproj" />
  </ItemGroup>

</Project>
